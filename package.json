{
  "name": "icloud-photo-slideshow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,green \"npm:dev:server\" \"npm:dev:ui\"",
    "build": "vite build && npm run build:server",
    "start": "STATIC_DIR=dist/ui dist/server",
    "lint": "eslint .",
    "dev:server": "PORT=8086 node --watch --env-file-if-exists=.env server/server.ts",
    "dev:ui": "vite",
    "build:server": "scriptc build server/server.ts -o dist/server --strip --no-keep-llvm",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "coverage:server": "scriptc coverage server/server.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "scriptc": "0.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "type": "module"
}
